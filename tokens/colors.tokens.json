      "$extensions": {
        "com.gearui.source": {
          "heroui": {
            "value": "var(--default)",
            "ref": "heroui-native 1.0.9 switch.animation.ts unselected track, light"
          },
          "ios": {
            "value": "rgb(197,197,199)",
            "ref": "iOS 26.2 Settings > Accessibility > Motion, off switch track, measured on simulator, light"
          },
          "basis": "ios",
          "why": "The off track has to read against the page. HeroUI's default fill sits 12 levels from GearUI's grouped background and disappears; the switch is iOS's signature control and takes its track."
        }
      }
    },
